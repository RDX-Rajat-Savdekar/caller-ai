# Dry-run is the default. Point at the local simulator unless you
# explicitly opt into a live dial (CALLE_LIVE=1 + a real API key).
CALLE_BASE_URL=http://localhost:4000
CALLE_API_KEY=sim-local
CALLE_LIVE=0

# Production API (only when CALLE_LIVE=1)
# CALLE_BASE_URL=https://api.heycall-e.com
# CALLE_API_KEY=iams_live_...

# Optional: override the smoke-call recipient. Seed data uses fictional +1555 numbers.
# CALLE_SMOKE_PHONE=+15555550100
